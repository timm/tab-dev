-- A deliberately simple rewrite of tab.yue's "histogram cut" block.
-- Same job: of every (column, threshold) pair, return the one whose
-- two sides have the least expected class entropy.  No pre-binning
-- pass, no flat count array, no shared scratch buffers, no
-- incremental entropy, and one sweep instead of two.
(tab) ->
  the, log, order, pick, NUM = tab.the, tab.log, tab.order, tab.pick, tab.NUM

  ent = (cs, n,    e) ->            -- bits; entropy of a count vector
    e = 0
    for _, c in pairs cs
      e -= c / n * log(c / n) if c > 0
    e / log 2

  (rows, cols) =>
    local bs, bc, bv
    kat = @klass.at
    for _, col in order pick(@x, cols)
      nb = col\slots!
      continue unless nb and nb > 1
      h, tot, n = {}, {}, 0         -- h[bin][klass], and the margin
      for _, row in order rows
        b = col\slot row[col.at]
        continue unless b
        k = row[kat]
        h[b] or= {}
        h[b][k] = (h[b][k] or 0) + 1
        tot[k]  = (tot[k]  or 0) + 1
        n += 1
      continue if n < 2 * the.leaf
      num  = getmetatable(col) == NUM
      this = {}                     -- numeric bins accumulate (`x <= e`),
      for b = 1, nb                 -- symbolic ones stand alone (`x == v`)
        this = {} unless num
        tn   = 0
        for k, c in pairs h[b] or {}
          this[k] = (this[k] or 0) + c
        for _, c in pairs this
          tn += c
        that, on = {}, n - tn
        for k, c in pairs tot
          that[k] = c - (this[k] or 0)
        continue if tn < the.leaf or on < the.leaf
        s = (ent(this, tn) * tn + ent(that, on) * on) / n
        if bs == nil or s < bs      -- strict `<` keeps the FIRST of a tie
          bs, bc, bv = s, col, col\edge b
    bs and {col: bc, v: bv}
